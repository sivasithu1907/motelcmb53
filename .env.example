# ─── Application Domain ───────────────────────────────────────────────────────
APP_DOMAIN=motelcmb53.duckdns.org

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=motelcmb53
POSTGRES_USER=motelcmb53
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# This is auto-assembled from the above in docker-compose.yml
# Uncomment to override manually:
# DATABASE_URL=postgresql://motelcmb53:CHANGE_THIS@db:5432/motelcmb53

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
COOKIE_SECRET=CHANGE_THIS_SECRET_32_BYTES_HEX

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://motelcmb53.duckdns.org

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIRECTORY=/app/uploads/documents
MAX_FILE_SIZE_MB=10

# ─── Runtime ──────────────────────────────────────────────────────────────────
TZ=Asia/Colombo
NODE_ENV=production
