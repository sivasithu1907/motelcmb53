# Motel CMB 53 — Environment Variables
# Copy to .env and fill in secrets before first launch
# NEVER commit .env to version control

# PostgreSQL
POSTGRES_DB=motelcmb53
POSTGRES_USER=motelcmb53
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Backend session secret (at least 32 random chars)
COOKIE_SECRET=CHANGE_THIS_64_CHAR_RANDOM_STRING

# Domain
APP_DOMAIN=motelcmb53.duckdns.org
ALLOWED_ORIGINS=https://motelcmb53.duckdns.org

# Optional
MAX_FILE_SIZE_MB=10
